# ============================================================================
# Yapin.gg Middleman Bot — Verified Configuration Template
# Copy this file to .env and fill in real values. NEVER commit .env to Git.
# ============================================================================

# Required: Bot token from Yapin' (Settings -> Developer -> Your Bot -> Token, starts with yb_)
YAPIN_BOT_TOKEN=

# Required: Official Yapin Bot REST API v1 base URL
YAPIN_API_BASE_URL=https://www.yapin.gg/api/bot/v1

# Required: MongoDB connection URI (Replica Set or Atlas recommended for multi-doc transactions)
MONGODB_URI=mongodb://127.0.0.1:27017/yapin_middleman

# Required: Target Yapin Server ID (UUID from Settings -> Advanced -> Developer Mode -> Copy Server ID)
YAPIN_SERVER_ID=

# Application runtime & logging
LOG_LEVEL=info
NODE_ENV=development

# Optional: Official Yapin Realtime WebSocket Gateway (set to "false" to force HTTPS long-polling)
YAPIN_GATEWAY_URL=wss://rt.yapper.website/bot
YAPIN_ENABLE_GATEWAY=true

# Optional: Signed Event Webhook receiver (Settings -> Developer -> Your Bot -> Advanced)
YAPIN_WEBHOOK_ENABLED=false
YAPIN_WEBHOOK_PORT=3100
YAPIN_WEBHOOK_PATH=/webhooks/yapin
YAPIN_WEBHOOK_SECRET=

# Optional: Staff Web Dashboard (Secured via official "Login with Yapin'" OAuth2 + server-side RBAC)
# Leave DASHBOARD_ENABLED=false unless OAuth2 credentials & session secret are configured.
DASHBOARD_ENABLED=false
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3200
DASHBOARD_SESSION_SECRET=
YAPIN_OAUTH_CLIENT_ID=
YAPIN_OAUTH_CLIENT_SECRET=
YAPIN_OAUTH_REDIRECT_URI=http://localhost:3200/auth/callback
YAPIN_SITE_URL=https://www.yapin.gg

# Optional: Opt-in Live Integration Test Suite (npm run test:live)
YAPIN_LIVE_TEST=false
YAPIN_TEST_CHANNEL_ID=
YAPIN_LIVE_STAFF_ROLE_ID=
