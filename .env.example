# ============================================================================
# MM2 Helper (Server: MurderMystery2) — Verified Yapin.gg Configuration
# Storage: Crash-safe local atomic JSON files in ./data (NO MongoDB needed!)
# Copy this file to .env and fill in real values. NEVER commit .env to Git.
# ============================================================================

# Required: Bot token from Yapin' (Settings -> Developer -> MM2 Helper -> Token, starts with yb_)
YAPIN_BOT_TOKEN=

# Required: MurderMystery2 Yapin Server ID (Settings -> Advanced -> Developer Mode -> Copy Server ID)
YAPIN_SERVER_ID=

# Official Yapin Bot REST API v1 base URL
YAPIN_API_BASE_URL=https://www.yapin.gg/api/bot/v1

# Local JSON storage directory (created automatically; zero external DB dependencies)
DATA_DIR=./data

# Application runtime & logging
LOG_LEVEL=info
NODE_ENV=development

# Optional: Official Yapin Realtime WebSocket Gateway (set to "false" to force HTTPS long-polling)
YAPIN_GATEWAY_URL=wss://rt.yapper.website/bot
YAPIN_ENABLE_GATEWAY=true

# Optional: Signed Event Webhook receiver (Settings -> Developer -> MM2 Helper -> Advanced)
YAPIN_WEBHOOK_ENABLED=false
YAPIN_WEBHOOK_PORT=3100
YAPIN_WEBHOOK_PATH=/webhooks/yapin
YAPIN_WEBHOOK_SECRET=

# Optional: Sheriff HQ Staff Web Console (Secured via official "Login with Yapin'" OAuth2 + PKCE)
# Leave DASHBOARD_ENABLED=false unless OAuth2 credentials & session secret (>=32 chars) are set.
DASHBOARD_ENABLED=false
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3200
DASHBOARD_SESSION_SECRET=
YAPIN_OAUTH_CLIENT_ID=
YAPIN_OAUTH_CLIENT_SECRET=
YAPIN_OAUTH_REDIRECT_URI=http://localhost:3200/auth/callback
YAPIN_SITE_URL=https://www.yapin.gg

# Optional: Opt-in Live Integration Test Suite (npm run test:live)
YAPIN_LIVE_TEST=false
YAPIN_TEST_CHANNEL_ID=
YAPIN_LIVE_STAFF_ROLE_ID=
